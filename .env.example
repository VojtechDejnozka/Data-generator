# ============================================================================ Story2Data configuration
# Copy to .env (repo root). Backend reads every variable; the Vite frontend sees ONLY VITE_* ones.
# Never put a secret into a VITE_* variable – it ends up in the public JS bundle.

# --- LLM (backend only) -----------------------------------------------------------------------------
GEMINI_API_KEY=
STRONG_MODEL=gemini-4-carbon
STRONG_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
CHEAP_MODEL=gemini-3.5-flash-lite
CHEAP_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash
# 1 = fixture responses, no network calls (works with or without auth)
# OpenAI API key (backend only)
OPENAI_API_KEY=
OPENAI_STRONG_MODEL=gpt-6-luna
OPENAI_STRONG_FALLBACK_MODELS=
OPENAI_CHEAP_MODEL=gpt-6-luna
OPENAI_CHEAP_FALLBACK_MODELS=
# 1 = use fixture responses, no network calls
LLM_MOCK=0
LLM_MAX_CONCURRENCY=4
LLM_CACHE=1

# --- Local files (dev without Supabase; on Vercel /tmp is used automatically) -----------------------
DATA_DIR=../runs
CACHE_DIR=../.cache/llm
# WORKSPACE_DIR=            # working copies of runs when Supabase Storage is the store
# WORKSPACE_CACHE_MB=300

# --- Supabase (Dashboard -> Project Settings -> API keys / Data API) --------------------------------
# Empty SUPABASE_URL = local mode (JSON files, no accounts) – then AUTH_DISABLED=1 is required.
SUPABASE_URL=
# publishable key (sb_publishable_…) or legacy anon key – safe for the browser
SUPABASE_PUBLISHABLE_KEY=
# secret key (sb_secret_…) or legacy service_role key – BACKEND ONLY, never VITE_*, never in git
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=runs
# Optional overrides (derived from SUPABASE_URL): JWKS endpoint, issuer, audience
# SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://<ref>.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# Legacy HS256 secret (old local `supabase start` setups only; ignored in production)
# SUPABASE_JWT_SECRET=

# --- Frontend (public) ---------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_AUTH_GOOGLE=0          # 1 = show "Pokračovat přes Google" (enable the provider in Supabase first)
VITE_AUTH_MAGIC_LINK=0      # 1 = show "Poslat přihlašovací odkaz"
# VITE_API_BASE_URL=        # only when the API runs on another origin (fallback deployment)

# --- Accounts & cost protection ------------------------------------------------------------------------
# open | email_allowlist | invite_only
SIGNUP_MODE=email_allowlist
# e-mails and/or @domains, comma separated (email_allowlist mode)
SIGNUP_ALLOWLIST=
QUOTA_RUNS_PER_DAY=20
QUOTA_TOKENS_PER_DAY=2000000
QUOTA_COUNT_MOCK=0
RATE_LIMIT_JOBS_PER_MINUTE=6

# --- HTTP -----------------------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# e.g. ^https://story2data(-[a-z0-9-]+)?-myteam\.vercel\.app$   (Vercel preview deployments)
CORS_ORIGIN_REGEX=
MAX_REQUEST_BYTES=2000000

# --- Dev only ---------------------------------------------------------------------------------------------
# 1 = no login, everything belongs to a local dev user. Refused when VERCEL_ENV or APP_ENV=production is set.
AUTH_DISABLED=1
# JOB_AUTODRIVE=1           # run job stages in the background (default locally; 0 on Vercel)
# APP_ENV=production        # marks a non-Vercel production deployment
