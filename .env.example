# Google AI Studio key (backend only – never commit the real value)
GEMINI_API_KEY=
# Planner / validator model and fallbacks (tried in order on quota 0 / persistent errors)
STRONG_MODEL=gemini-4-carbon
STRONG_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Bulk data generator model and fallbacks
CHEAP_MODEL=gemini-3.5-flash-lite
CHEAP_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash
# 1 = use fixture responses, no network calls
LLM_MOCK=0
LLM_MAX_CONCURRENCY=4
LLM_CACHE=1
# Where runs and cache are stored (relative to backend/)
DATA_DIR=../runs
CACHE_DIR=../.cache/llm
