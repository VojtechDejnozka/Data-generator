{
  "meta": {
    "scenario_id": "education_tutoring",
    "name": "Školy – pilotní doučování",
    "description": "Pilotní program doučování v jedné škole zlepšuje průběžné výsledky doučovaných žáků; výběr do doučování je ovlivněn socioekonomickým zázemím.",
    "domain": "education",
    "original_story": "Ve čtyřech školách sledujeme žáky během semestru. Od 6. týdne běží v jedné škole pilotní doučování. Doučovaní žáci se zlepšují, ale do doučování se častěji hlásí slabší žáci z horšího zázemí, takže prostý rozdíl průměrů je zavádějící.",
    "refined_story": "SES (latentní) ovlivňuje předchozí výsledky, motivaci, docházku i výběr do doučování (confounding). Průběžné skóre závisí na předchozích výsledcích, docházce a rizikovém příznaku nízké docházky (podmíněný mechanismus). Od 6. týdne se ve škole 2 zapíná efekt doučování (změna koeficientu, náběh 4 týdny). Závěrečný výsledek závisí na průměru průběžných skóre.",
    "language": "cs",
    "seed": 7,
    "assumptions": ["Docházka je podíl odučených hodin v týdnu.", "Efekt doučování existuje jen v pilotní škole 2."]
  },
  "time": {"start": "2025-09-01", "periods": 16, "frequency": "W", "time_column": "week_start"},
  "entities": [
    {"entity_id": "schools", "grain": "jedna škola", "kind": "base", "count": 4, "primary_key": "school_id"},
    {"entity_id": "classes", "grain": "jedna třída", "kind": "base", "count": 16, "primary_key": "class_id",
     "assignments": [{"entity": "schools", "method": "balanced"}]},
    {"entity_id": "students", "grain": "jeden žák", "kind": "base", "count": 480, "primary_key": "student_id",
     "assignments": [{"entity": "classes", "method": "balanced"}]},
    {"entity_id": "student_weeks", "name": "weekly_progress", "grain": "jeden žák v jednom týdnu", "kind": "cross",
     "cross": ["students"], "temporal": true, "primary_key": "progress_id"},
    {"entity_id": "final_results", "grain": "závěrečný výsledek jednoho žáka", "kind": "child", "parent": "students",
     "count": 1, "primary_key": "result_id",
     "relationships": [{"target": "students", "cardinality": "one_to_one"}]}
  ],
  "variables": [
    {"variable_id": "school_name", "entity": "schools", "column": "name", "data_type": "text", "semantic_type": "label", "role": "label",
     "mechanism": {"type": "label", "params": {"values": ["ZŠ Na Kopci", "ZŠ U Lesa", "ZŠ Komenského", "ZŠ Polní"]}}},
    {"variable_id": "school_type", "entity": "schools", "column": "type", "data_type": "category", "semantic_type": "categorical",
     "categories": ["městská", "venkovská"],
     "mechanism": {"type": "exogenous", "params": {"distribution": {"family": "categorical", "categories": ["městská", "venkovská"], "probs": [0.5, 0.5]}}}},
    {"variable_id": "teacher_experience", "entity": "classes", "column": "teacher_experience_years", "semantic_type": "continuous",
     "unit": "roky", "constraints": {"round": 1},
     "mechanism": {"type": "exogenous", "params": {"distribution": {"family": "gamma", "params": {"mean": 12, "sd": 6}}}}},
    {"variable_id": "class_size", "entity": "classes", "column": "class_size", "data_type": "int", "semantic_type": "count",
     "mechanism": {"type": "exogenous", "params": {"distribution": {"family": "poisson", "params": {"rate": 24}}}}},
    {"variable_id": "ses", "entity": "students", "column": null, "observability": "latent",
     "description": "Socioekonomický status (standardizovaný)",
     "mechanism": {"type": "exogenous", "params": {"distribution": {"family": "normal", "params": {"mean": 0, "sd": 1}}}}},
    {"variable_id": "prior_score", "entity": "students", "column": "prior_score", "semantic_type": "continuous", "constraints": {"round": 1},
     "parents": [{"variable": "ses"}, {"variable": "teacher_experience", "alias": "exp"}],
     "mechanism": {"type": "linear", "params": {"intercept": 58, "coefficients": {"ses": 7, "exp": 0.3},
                   "noise": {"family": "normal", "params": {"sd": 7}}}}},
    {"variable_id": "tutoring", "entity": "students", "column": "tutoring", "data_type": "bool", "semantic_type": "binary",
     "parents": [{"variable": "ses"}, {"variable": "prior_score", "alias": "prior"}],
     "mechanism": {"type": "logistic", "params": {"intercept": 2.0, "coefficients": {"ses": -0.6, "prior": -0.045}}}},
    {"variable_id": "motivation", "entity": "students", "column": "motivation", "data_type": "category", "semantic_type": "ordinal",
     "categories": ["nízká", "střední", "vysoká", "velmi vysoká"],
     "parents": [{"variable": "ses"}],
     "mechanism": {"type": "ordinal_threshold", "params": {"coefficients": {"ses": 0.6}, "cutpoints": [-1.0, 0.0, 1.0],
                   "noise": {"family": "normal", "params": {"sd": 1.0}}}}},
    {"variable_id": "attendance_rate", "entity": "student_weeks", "column": "attendance_rate", "semantic_type": "continuous",
     "constraints": {"min": 0, "max": 1, "clip": true, "round": 3},
     "parents": [{"variable": "ses"}, {"variable": "motivation"}],
     "mechanism": {"type": "linear", "params": {"intercept": 0.86, "coefficients": {"ses": 0.04, "motivation=nízká": -0.08, "motivation=velmi vysoká": 0.04},
                   "noise": {"family": "normal", "params": {"sd": 0.06}}}}},
    {"variable_id": "low_attendance", "entity": "student_weeks", "column": null, "observability": "latent", "data_type": "bool",
     "parents": [{"variable": "attendance_rate", "alias": "att"}],
     "mechanism": {"type": "conditional", "params": {"cases": [{"when": "att < 0.75", "value": "1"}], "default": "0"}}},
    {"variable_id": "homework_done", "entity": "student_weeks", "column": "homework_done", "data_type": "int", "semantic_type": "count",
     "parents": [{"variable": "attendance_rate", "alias": "att"}, {"variable": "motivation"}],
     "mechanism": {"type": "poisson_regression", "params": {"intercept": 1.0, "coefficients": {"att": 0.6, "motivation=nízká": -0.4}}}},
    {"variable_id": "weekly_score", "entity": "student_weeks", "column": "weekly_score", "semantic_type": "continuous", "constraints": {"round": 1},
     "parents": [{"variable": "prior_score", "alias": "prior"}, {"variable": "attendance_rate", "alias": "att"},
                 {"variable": "low_attendance", "alias": "risk"}, {"variable": "tutoring"}, {"variable": "homework_done", "alias": "hw"}],
     "mechanism": {"type": "linear", "params": {"intercept": 12, "coefficients": {"prior": 0.7, "att": 15, "risk": -6, "tutoring": 0.0, "hw": 0.8},
                   "noise": {"family": "normal", "params": {"sd": 5}}}}},
    {"variable_id": "avg_weekly_score", "entity": "students", "column": null, "observability": "latent",
     "parents": [{"variable": "weekly_score", "aggregation": "mean"}], "mechanism": {"type": "aggregation", "params": {}}},
    {"variable_id": "final_score", "entity": "final_results", "column": "final_score", "semantic_type": "continuous", "constraints": {"round": 1},
     "parents": [{"variable": "avg_weekly_score", "alias": "avg"}, {"variable": "prior_score", "alias": "prior"}],
     "mechanism": {"type": "linear", "params": {"intercept": 5, "coefficients": {"avg": 0.7, "prior": 0.2},
                   "noise": {"family": "normal", "params": {"sd": 4}}}}},
    {"variable_id": "passed", "entity": "final_results", "column": "passed", "data_type": "bool", "semantic_type": "binary",
     "parents": [{"variable": "final_score", "alias": "score"}],
     "mechanism": {"type": "threshold", "params": {"coefficients": {"score": 1}, "threshold": 60}}},
    {"variable_id": "grade", "entity": "final_results", "column": "grade", "data_type": "category", "semantic_type": "ordinal",
     "categories": ["F", "D", "C", "B", "A"], "parents": [{"variable": "final_score", "alias": "score"}],
     "mechanism": {"type": "ordinal_threshold", "params": {"coefficients": {"score": 1}, "cutpoints": [55, 62, 70, 78],
                   "noise": {"family": "normal", "params": {"sd": 1.5}}}}}
  ],
  "events": [
    {"event_id": "tutoring_pilot", "description": "Pilotní doučování ve škole 2 od 6. týdne",
     "affected_variables": ["weekly_score"], "affected_entities": "school_id == 2", "start_time": 5,
     "intervention_type": "param_change", "intervention_parameters": {"param": "coefficients.tutoring", "value": 9.0},
     "ramp_profile": "linear", "ramp_periods": 4, "kind": "story"}
  ],
  "ground_truth": {
    "story_facts": [
      {"fact_id": "pilot_effect", "kind": "root_cause", "importance": 3, "event_id": "tutoring_pilot",
       "description": "Od 6. týdne se ve škole 2 zlepšují průběžná skóre doučovaných žáků.",
       "entity_ids": {"schools": [2]}, "evidence_variables": ["weekly_score"], "expected_direction": "+", "tolerance_periods": 3},
      {"fact_id": "edge_attendance_score", "kind": "edge", "importance": 1.5, "source": "attendance_rate", "target": "weekly_score",
       "expected_direction": "+", "description": "Docházka zvyšuje průběžné skóre."},
      {"fact_id": "edge_prior_score", "kind": "edge", "importance": 1, "source": "prior_score", "target": "weekly_score",
       "expected_direction": "+", "description": "Předchozí výsledky předpovídají průběžné skóre."},
      {"fact_id": "edge_tutoring_score", "kind": "edge", "importance": 1.5, "source": "tutoring", "target": "weekly_score",
       "expected_direction": "+", "description": "Doučování zlepšuje skóre (jen v pilotní škole)."},
      {"fact_id": "edge_weekly_final", "kind": "edge", "importance": 1, "source": "weekly_score", "target": "final_score",
       "expected_direction": "+", "description": "Průběžné výsledky určují závěrečné skóre."}
    ],
    "key_causes": ["tutoring", "attendance_rate"],
    "key_effects": ["weekly_score", "final_score"],
    "control_groups": [{"description": "Doučovaní žáci v ostatních školách", "entity": "students", "filter": "school_id != 2"}],
    "alternative_interpretations": ["Doučovaní žáci mají horší výsledky – selekce podle SES a předchozích výsledků, nikoli negativní efekt doučování."],
    "effects_to_estimate": [["attendance_rate", "weekly_score"], ["prior_score", "final_score"]]
  },
  "difficulty": {"target_difficulty": 50}
}
